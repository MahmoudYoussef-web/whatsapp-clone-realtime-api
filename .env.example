# Copy to .env and adjust. All values have safe dev defaults in docker-compose.yml.
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=whatsapp_clone
POSTGRES_PORT=5432

KEYCLOAK_PORT=9090
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=whatsapp-media
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

REDIS_PORT=6379

TURN_REALM=whatsapp-clone
TURN_USER=wauser
TURN_PASSWORD=changeme
TURN_PORT=3478

# Backend overrides (spring reads these too)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/whatsapp_clone
SPRING_DATASOURCE_USERNAME=username
SPRING_DATASOURCE_PASSWORD=password
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_SECURITY_OAUTH2_ISSUER_URI=http://localhost:9090/realms/whatsapp-clone
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_WS_ALLOWED_ORIGINS=http://localhost:4200
MINIO_ENDPOINT=http://localhost:9000
